#!/bin/sh
# Let regular users draw to the screen (video), read the keyboard (input) and use the mic (audio).
set -e
for user in $(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 {print $1}'); do
    for grp in video input audio; do
        if getent group "$grp" >/dev/null; then
            usermod -aG "$grp" "$user" || true
        fi
    done
done
exit 0
